{
  "name": "@justia/lazyframe",
  "description": "Dependency-free library for lazyloading iframes",
  "version": "2.4.0",
  "author": "Viktor Bergehall",
  "bugs": {
    "url": "https://github.com/justia/lazyframe/issues"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "ava": "^6.4.1",
    "jsdom": "^27.1.0",
    "rollup": "^4.53.3",
    "rollup-plugin-scss": "^4.0.1",
    "sass": "^1.42.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3"
  },
  "homepage": "https://vb.github.io/lazyframe",
  "keywords": [
    "embed",
    "iframe",
    "javascript",
    "lazyload",
    "lazyloading",
    "pageload",
    "pagespeed",
    "vimeo",
    "youtube"
  ],
  "license": "MIT",
  "main": "dist/lazyframe.min.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/justia/lazyframe.git"
  },
  "scripts": {
    "prebuild": "rm -rf dist/",
    "build": "rollup --config rollup.config.ts --configPlugin typescript",
    "dev": "rollup --config rollup.config.ts --configPlugin typescript --watch",
    "test": "npm run build && ava -s",
    "test:watch": "npm run build && ava -s -w",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "dist",
    "src"
  ]
}
